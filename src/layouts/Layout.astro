---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'recipes' | 'index' | 'about';
}

const {
  title = "Paul's Recipes",
  description = "A collection of everyday curries, soups, and vegetarian mains.",
  activeNav = 'recipes',
} = Astro.props;

const pageTitle = title.includes("Paul's Recipes") ? title : `${title} · Paul's Recipes`;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Google Fonts: Fraunces (warm editorial serif) + Plus Jakarta Sans (clean body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style is:global>
      h1, h2, h3, .font-display {
        font-family: 'Fraunces', Georgia, serif;
      }
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col bg-[#faf7f2] text-stone-800">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-[#faf7f2]/90 backdrop-blur-md border-b border-stone-200/80 transition-shadow">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        <!-- Logo / Title -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-600 to-orange-700 flex items-center justify-center text-amber-50 shadow-sm group-hover:scale-105 transition-transform">
            <!-- Cooking pot icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11h16a1 1 0 0 1 1 1v6a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-6a1 1 0 0 1 1-1Z"/>
              <path d="M2 11h20"/>
              <path d="M9 7c0-1.5.5-3 3-3s3 1.5 3 3"/>
            </svg>
          </div>
          <div>
            <span class="block text-xl font-bold font-display text-stone-900 group-hover:text-amber-800 transition-colors tracking-tight">
              Paul's Recipes
            </span>
            <span class="block text-xs font-medium text-stone-600 -mt-0.5">
              the-kennedys.me.uk
            </span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-1 sm:gap-2">
          <a
            href="/"
            class:list={[
              "px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all",
              activeNav === 'recipes'
                ? "bg-amber-100/80 text-amber-950 shadow-xs"
                : "text-stone-700 hover:text-stone-900 hover:bg-stone-200/60"
            ]}
          >
            Recipes
          </a>
          <a
            href="/recipe-index"
            class:list={[
              "px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all",
              activeNav === 'index'
                ? "bg-amber-100/80 text-amber-950 shadow-xs"
                : "text-stone-700 hover:text-stone-900 hover:bg-stone-200/60"
            ]}
          >
            Recipe Index
          </a>
          <a
            href="/about"
            class:list={[
              "px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all",
              activeNav === 'about'
                ? "bg-amber-100/80 text-amber-950 shadow-xs"
                : "text-stone-700 hover:text-stone-900 hover:bg-stone-200/60"
            ]}
          >
            About
          </a>
          <a
            href="https://github.com/the-kennedys/the-kennedys.github.io"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub Repository"
            class="p-2 ml-1 text-stone-600 hover:text-stone-900 hover:bg-stone-200/60 rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-stone-200/80 bg-[#f4f0e8] py-8 text-center text-sm text-stone-600">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-display text-stone-900 font-semibold">
          <span>Paul's Recipes</span>
          <span class="text-stone-300">•</span>
          <span class="text-xs font-sans text-stone-600 font-normal">Made for cooking, not rambling.</span>
        </div>
        <div class="flex items-center gap-6 text-xs text-stone-600">
          <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
          <a href="/recipe-index" class="hover:text-stone-900 transition-colors">Recipe Index</a>
          <a href="/about" class="hover:text-stone-900 transition-colors">About</a>
          <a href="https://github.com/the-kennedys/the-kennedys.github.io" class="hover:text-stone-900 transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
