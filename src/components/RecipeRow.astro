---
import { getServings, getPrepCookTime, getExcerpt, getTags } from '../utils/recipes';

interface Props {
  recipe: any;
}

const { recipe } = Astro.props;
const servings = getServings(recipe.data);
const { prep, cook } = getPrepCookTime(recipe.data);
const excerpt = getExcerpt(recipe.body || '');
const tags = getTags(recipe.data.index_entry);
const rawCategory = (recipe.data.contents_entry || 'mains').toLowerCase();

// Collect portion and timings for the RHS
const metaItems: string[] = [];
if (servings) metaItems.push(servings);
if (prep) metaItems.push(prep);
if (cook) metaItems.push(cook);
---

<article
  class="recipe-item border-b border-stone-200/70 pb-3 mb-3 last:border-b-0 last:mb-0"
  data-category={rawCategory}
  data-title={recipe.data.title.toLowerCase()}
  data-tags={tags.join(' ')}
>
  <!-- Line 1: Recipe name (LHS) and portion / prep / cook (RHS) -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4">
    <h3 class="text-base sm:text-lg font-bold font-display text-stone-900 tracking-tight">
      <a
        href={`/recipes/${recipe.id}`}
        class="hover:text-amber-800 hover:underline underline-offset-4 decoration-amber-600/40 transition-colors"
      >
        {recipe.data.title}
      </a>
    </h3>

    {metaItems.length > 0 && (
      <div class="text-xs sm:text-sm font-medium text-stone-500 shrink-0">
        {metaItems.join(' · ')}
      </div>
    )}
  </div>

  <!-- Line 2: First part of description -->
  {excerpt && (
    <p class="text-xs sm:text-sm text-stone-600 mt-1 leading-relaxed italic line-clamp-2">
      {excerpt}
    </p>
  )}
</article>
