---
import { getServings, getPrepCookTime, getExcerpt, getTags } from '../utils/recipes';

interface Props {
  recipe: any;
}

const { recipe } = Astro.props;
const servings = getServings(recipe.data);
const { prep, cook } = getPrepCookTime(recipe.data);
const excerpt = getExcerpt(recipe.body || '');
const tags = getTags(recipe.data.index_entry);
const rawCategory = (recipe.data.contents_entry || 'mains').toLowerCase();
---

<article
  class="recipe-item group relative bg-white/90 hover:bg-white rounded-xl border border-stone-200/90 hover:border-amber-400/90 p-3.5 sm:p-4 shadow-2xs hover:shadow-xs transition-all duration-150 flex flex-col justify-between"
  data-category={rawCategory}
  data-title={recipe.data.title.toLowerCase()}
  data-tags={tags.join(' ')}
>
  <div>
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base sm:text-lg font-bold font-display text-stone-900 group-hover:text-amber-800 transition-colors leading-snug">
        <a href={`/recipes/${recipe.id}`} class="after:absolute after:inset-0 focus:outline-hidden">
          {recipe.data.title}
        </a>
      </h3>
      <span class="text-amber-700 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all shrink-0 text-sm font-semibold select-none">
        →
      </span>
    </div>

    {excerpt && (
      <p class="text-xs text-stone-600 line-clamp-1 mt-1 italic">
        "{excerpt}"
      </p>
    )}
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 pt-2.5 mt-2.5 border-t border-stone-100 text-xs text-stone-600 relative z-10">
    <div class="flex flex-wrap items-center gap-1.5 pointer-events-none">
      {servings && (
        <span class="inline-flex items-center gap-1 text-[11px] font-medium bg-stone-100 text-stone-700 px-2 py-0.5 rounded-md">
          <svg class="w-3 h-3 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
          </svg>
          {servings}
        </span>
      )}
      {prep && (
        <span class="inline-flex items-center text-[11px] font-medium bg-stone-100 text-stone-700 px-2 py-0.5 rounded-md">
          ⏱ {prep}
        </span>
      )}
      {cook && (
        <span class="inline-flex items-center text-[11px] font-medium bg-stone-100 text-stone-700 px-2 py-0.5 rounded-md">
          🔥 {cook}
        </span>
      )}
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 pointer-events-none ml-auto">
        {tags.slice(0, 2).map((tag) => (
          <span class="text-[10px] text-stone-500 bg-stone-50 border border-stone-200/60 px-1.5 py-0.5 rounded-sm">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
