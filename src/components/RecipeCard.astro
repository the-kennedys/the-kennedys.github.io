---
import { getCategoryBadge, getServings, getExcerpt, getTags } from '../utils/recipes';

interface Props {
  recipe: any;
}

const { recipe } = Astro.props;
const category = getCategoryBadge(recipe.data.contents_entry);
const servings = getServings(recipe.body || '');
const excerpt = getExcerpt(recipe.body || '');
const tags = getTags(recipe.data.index_entry);
const rawCategory = (recipe.data.contents_entry || 'mains').toLowerCase();
---

<article
  class="recipe-card group relative bg-white rounded-2xl border border-stone-200/90 hover:border-amber-400/80 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col overflow-hidden"
  data-category={rawCategory}
  data-title={recipe.data.title.toLowerCase()}
  data-tags={tags.join(' ')}
>
  <div class="p-6 flex-1 flex flex-col">
    <!-- Top Metadata: Category Pill & Servings -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class:list={[
        "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold border",
        category.bgClass
      ]}>
        <span class:list={["w-1.5 h-1.5 rounded-full", category.dotClass]}></span>
        {category.name}
      </span>

      {servings && (
        <span class="inline-flex items-center gap-1 text-xs font-medium text-stone-600 bg-stone-100 px-2 py-0.5 rounded-md">
          <svg class="w-3.5 h-3.5 text-stone-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          {servings}
        </span>
      )}
    </div>

    <!-- Title -->
    <h2 class="text-xl font-bold font-display text-stone-900 group-hover:text-amber-700 transition-colors tracking-tight mb-2">
      <a href={`/recipes/${recipe.id}`} class="after:absolute after:inset-0 focus:outline-hidden">
        {recipe.data.title}
      </a>
    </h2>

    <!-- Excerpt / Note -->
    {excerpt && (
      <p class="text-sm text-stone-600 line-clamp-2 mb-4 leading-relaxed italic">
        "{excerpt}"
      </p>
    )}

    <!-- Tags footer -->
    <div class="mt-auto pt-4 border-t border-stone-100 flex flex-wrap items-center justify-between gap-2 relative z-10">
      <div class="flex flex-wrap gap-1.5 pointer-events-none">
        {tags.slice(0, 3).map((tag) => (
          <span class="inline-block text-[11px] font-medium text-stone-600 bg-stone-50 border border-stone-200/60 px-2 py-0.5 rounded-sm">
            #{tag}
          </span>
        ))}
        {tags.length > 3 && (
          <span class="text-[11px] font-medium text-stone-600 self-center">
            +{tags.length - 3}
          </span>
        )}
      </div>

      <a
        href={`/recipes/${recipe.id}`}
        class="text-xs font-semibold text-amber-700 group-hover:text-amber-900 group-hover:translate-x-0.5 transition-all inline-flex items-center gap-1 cursor-pointer"
      >
        Cook 
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
