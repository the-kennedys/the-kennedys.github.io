---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RecipeRow from '../components/RecipeRow.astro';
import { getTags, formatCategory, getCategoryBadge } from '../utils/recipes';

const allRecipes = await getCollection('recipes');

// Category display order
const CATEGORY_ORDER = ['curries', 'mains', 'soups', 'baking'];

// Group recipes by category
const grouped = new Map<string, typeof allRecipes>();
allRecipes.forEach((recipe) => {
  const catKey = (recipe.data.contents_entry || 'mains').toLowerCase().trim();
  if (!grouped.has(catKey)) {
    grouped.set(catKey, []);
  }
  grouped.get(catKey)!.push(recipe);
});

// Sort each category alphabetically by title
grouped.forEach((recipes) => {
  recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
});

// Build ordered category sections
const recipesByCategory: {
  key: string;
  label: string;
  badge: ReturnType<typeof getCategoryBadge>;
  recipes: typeof allRecipes;
}[] = [];

const processedKeys = new Set<string>();
for (const key of CATEGORY_ORDER) {
  if (grouped.has(key)) {
    processedKeys.add(key);
    recipesByCategory.push({
      key,
      label: formatCategory(key),
      badge: getCategoryBadge(key),
      recipes: grouped.get(key)!,
    });
  }
}
for (const [key, recipes] of grouped.entries()) {
  if (!processedKeys.has(key)) {
    recipesByCategory.push({
      key,
      label: formatCategory(key),
      badge: getCategoryBadge(key),
      recipes,
    });
  }
}

// Popular tags for quick filter chips
const tagSet = new Set<string>();
allRecipes.forEach((r) => {
  getTags(r.data.index_entry).forEach((t) => tagSet.add(t));
});
const popularTags = ['lentils', 'halloumi', 'beetroot', 'spinach', 'mushroom', 'rice', 'tomato', 'curry'];
---

<Layout title="Paul's Recipes · Table of Contents" activeNav="recipes">
  <!-- Hero Section -->
  <div class="mb-8 text-center sm:text-left sm:flex sm:items-end sm:justify-between gap-6 pb-6 border-b border-stone-200/80">
    <div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-stone-900 tracking-tight mb-2">
        Recipe Contents
      </h1>
      <p class="text-base sm:text-lg text-stone-600 max-w-2xl leading-relaxed">
        Everyday curries, soups, and vegetarian mains. Quick to scan, no life stories — just ingredients and method.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex sm:flex-col items-center sm:items-end justify-center gap-1 text-xs font-semibold text-stone-600 bg-stone-100/80 px-3.5 py-2 rounded-xl border border-stone-200/60 shrink-0">
      <span class="text-stone-900 text-sm font-bold">{allRecipes.length} Total Recipes</span>
      <span>{recipesByCategory.length} Chapters</span>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="space-y-4 mb-8 sticky top-18 z-30 bg-[#faf7f2]/95 backdrop-blur-md pt-2 pb-4 -mt-2">
    <div class="flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
      <!-- Category Tabs (Chapters) -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 bg-stone-200/70 rounded-xl max-w-fit" id="category-tabs">
        <button
          type="button"
          data-filter="all"
          class="cat-tab active px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all shadow-xs bg-white text-stone-900 cursor-pointer"
        >
          All <span class="ml-1 text-xs opacity-70">({allRecipes.length})</span>
        </button>
        {recipesByCategory.map((cat) => (
          <button
            type="button"
            data-filter={cat.key}
            class="cat-tab px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-stone-600 hover:text-stone-900 transition-all cursor-pointer"
          >
            {cat.label} <span class="ml-1 text-xs opacity-70">({cat.recipes.length})</span>
          </button>
        ))}
      </div>

      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <input
          type="text"
          id="recipe-search"
          placeholder="Filter by title or ingredient (e.g. lentil, soup, ginger)..."
          class="w-full pl-10 pr-9 py-2 bg-white border border-stone-200 rounded-xl text-sm placeholder:text-stone-400 focus:outline-hidden focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all"
        />
        <button
          type="button"
          id="clear-search"
          class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 cursor-pointer"
          title="Clear search"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Quick index filter chips -->
    <div class="flex flex-wrap items-center gap-1.5 text-xs text-stone-600">
      <span class="font-medium">Quick filters:</span>
      {popularTags.map((tag) => (
        <button
          type="button"
          class="tag-pill px-2.5 py-0.5 rounded-md bg-stone-100 hover:bg-amber-100 hover:text-amber-900 border border-stone-200/70 transition-colors cursor-pointer capitalize"
          data-tag={tag}
        >
          {tag}
        </button>
      ))}
    </div>

    <!-- Active filter & count indicator -->
    <div class="flex items-center justify-between text-xs text-stone-600 pt-1 border-t border-stone-200/60">
      <span id="results-count">Showing all {allRecipes.length} recipes across {recipesByCategory.length} categories</span>
      <button
        id="reset-all"
        class="hidden text-amber-700 hover:underline font-semibold cursor-pointer"
      >
        Reset filters
      </button>
    </div>
  </div>

  <!-- Table of Contents Category Sections -->
  <div id="recipe-contents" class="space-y-10">
    {recipesByCategory.map((category) => (
      <section
        class="category-section scroll-mt-36"
        id={`cat-${category.key}`}
        data-section-category={category.key}
      >
        <!-- Chapter Header -->
        <div class="flex items-center justify-between pb-2.5 mb-3.5 border-b-2 border-stone-200/90">
          <div class="flex items-center gap-2.5">
            <span class:list={["w-2.5 h-2.5 rounded-full", category.badge.dotClass]}></span>
            <h2 class="text-xl sm:text-2xl font-bold font-display text-stone-900 tracking-tight">
              {category.label}
            </h2>
            <span class="category-count text-xs font-semibold px-2 py-0.5 rounded-full bg-stone-100 text-stone-600 border border-stone-200/70">
              {category.recipes.length}
            </span>
          </div>

          <span class="text-xs text-stone-600 font-medium hidden sm:inline">
            {category.recipes.length === 1 ? '1 recipe' : `${category.recipes.length} recipes`}
          </span>
        </div>

        <!-- Recipe Cards Grid (2 columns) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 recipe-list">
          {category.recipes.map((recipe) => (
            <RecipeRow recipe={recipe} />
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Empty State (Hidden by default) -->
  <div id="empty-state" class="hidden py-16 text-center bg-white rounded-2xl border border-stone-200 my-6">
    <div class="w-12 h-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center text-amber-700 mb-3">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
    </div>
    <h3 class="text-lg font-bold font-display text-stone-900 mb-1">No recipes found</h3>
    <p class="text-sm text-stone-600 mb-4 max-w-sm mx-auto">
      No recipes match your current search and category filters.
    </p>
    <button
      type="button"
      id="empty-reset-btn"
      class="px-4 py-2 bg-amber-700 hover:bg-amber-800 text-white rounded-xl text-xs font-semibold shadow-xs transition-colors cursor-pointer"
    >
      Reset all filters
    </button>
  </div>
</Layout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('recipe-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-search');
  const resetBtn = document.getElementById('reset-all');
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const resultsCount = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');
  const contentsContainer = document.getElementById('recipe-contents');
  const catButtons = document.querySelectorAll('#category-tabs .cat-tab');
  const tagPills = document.querySelectorAll('.tag-pill');
  const sections = document.querySelectorAll<HTMLElement>('.category-section');

  let currentCategory = 'all';
  let searchQuery = '';

  function updateFilter() {
    let totalVisible = 0;
    let visibleCategories = 0;
    const totalCount = document.querySelectorAll('.recipe-item').length;
    const q = searchQuery.toLowerCase().trim();

    sections.forEach((section) => {
      const sectionCategory = section.getAttribute('data-section-category') || '';
      const matchesCat = currentCategory === 'all' || sectionCategory === currentCategory;

      if (!matchesCat) {
        section.style.display = 'none';
        return;
      }

      let sectionVisibleCount = 0;
      const items = section.querySelectorAll<HTMLElement>('.recipe-item');

      items.forEach((item) => {
        const title = item.dataset.title || '';
        const tags = item.dataset.tags || '';
        const matchesSearch = !q || title.includes(q) || tags.includes(q) || sectionCategory.includes(q);

        if (matchesSearch) {
          item.style.display = 'flex';
          sectionVisibleCount++;
          totalVisible++;
        } else {
          item.style.display = 'none';
        }
      });

      if (sectionVisibleCount > 0) {
        section.style.display = 'block';
        visibleCategories++;
        const countBadge = section.querySelector('.category-count');
        if (countBadge) {
          countBadge.textContent = `${sectionVisibleCount}`;
        }
      } else {
        section.style.display = 'none';
      }
    });

    // Update count display
    if (resultsCount) {
      if (totalVisible === totalCount && !q && currentCategory === 'all') {
        resultsCount.textContent = `Showing all ${totalCount} recipes across ${sections.length} categories`;
      } else if (currentCategory !== 'all') {
        const catBtn = document.querySelector(`#category-tabs button[data-filter="${currentCategory}"]`);
        const catLabel = catBtn ? catBtn.textContent?.split('(')[0].trim() : 'category';
        resultsCount.textContent = `Showing ${totalVisible} recipes in ${catLabel}`;
      } else {
        resultsCount.textContent = `Showing ${totalVisible} of ${totalCount} recipes across ${visibleCategories} categories`;
      }
    }

    // Toggle empty state
    if (totalVisible === 0) {
      emptyState?.classList.remove('hidden');
      contentsContainer?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      contentsContainer?.classList.remove('hidden');
    }

    // Toggle reset buttons
    const isFiltered = currentCategory !== 'all' || q !== '';
    if (resetBtn) {
      if (isFiltered) resetBtn.classList.remove('hidden');
      else resetBtn.classList.add('hidden');
    }

    if (clearBtn) {
      if (q) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
  }

  // Category Tab clicks
  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('bg-white', 'text-stone-900', 'shadow-xs', 'active');
        b.classList.add('text-stone-600');
      });
      btn.classList.add('bg-white', 'text-stone-900', 'shadow-xs', 'active');
      btn.classList.remove('text-stone-600');

      currentCategory = btn.getAttribute('data-filter') || 'all';
      updateFilter();
    });
  });

  // Search input typing
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    updateFilter();
  });

  // Clear search button
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    searchInput?.focus();
    updateFilter();
  });

  // Tag pill clicks
  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const tag = pill.getAttribute('data-tag') || '';
      if (searchInput) {
        searchInput.value = tag;
        searchQuery = tag;
        searchInput.focus();
        updateFilter();
      }
    });
  });

  // Reset all handler
  function resetAll() {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    currentCategory = 'all';

    catButtons.forEach((b) => {
      const filter = b.getAttribute('data-filter');
      if (filter === 'all') {
        b.classList.add('bg-white', 'text-stone-900', 'shadow-xs', 'active');
        b.classList.remove('text-stone-600');
      } else {
        b.classList.remove('bg-white', 'text-stone-900', 'shadow-xs', 'active');
        b.classList.add('text-stone-600');
      }
    });

    updateFilter();
  }

  resetBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);

  // Check URL parameters on page load (e.g., ?tag=lentils)
  const urlParams = new URLSearchParams(window.location.search);
  const tagParam = urlParams.get('tag');
  if (tagParam && searchInput) {
    searchInput.value = tagParam;
    searchQuery = tagParam;
    updateFilter();
  }
</script>
